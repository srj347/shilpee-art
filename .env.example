# Copy to .env.local for development, or to .env on the server.

# Public site address, no trailing slash
SITE_URL=http://localhost:3000

# MongoDB. Local: the Docker container from docker-compose.yml. Production: MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27018/shilpee

# Long random strings (at least 32 characters). Generate with: openssl rand -hex 32
SESSION_SECRET=
FORM_SECRET=
CRON_SECRET=

# Emails that may sign in to Studio, comma separated
ADMIN_EMAILS=

# Image storage: "local" (files under STORAGE_DIR) or "s3"
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Where browsers load images from. Local: /media. Production: https://img.your-domain.com
NEXT_PUBLIC_MEDIA_BASE_URL=/media
S3_REGION=ap-south-1
# Public bucket behind CloudFront (img/...)
S3_PUBLIC_BUCKET=
# Private bucket for full-size masters and backups
S3_PRIVATE_BUCKET=
# Only if the server has no IAM role: keys for an IAM user with s3:PutObject and ses:SendEmail
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Email: "console" (writes to STORAGE_DIR/outbox) or "ses"
MAIL_DRIVER=console
MAIL_FROM="Shilpee Maitra <studio@shilpeemaitra.com>"
SES_REGION=ap-south-1

# Optional: Umami Cloud website id (cookie-free analytics)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
