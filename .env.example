# Copy to .env.local for development, or to .env on the server.

# Public site address, no trailing slash
SITE_URL=http://localhost:3000

# MongoDB. Local: the Docker container from docker-compose.yml. Production: MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27018/shilpee

# Long random strings (at least 32 characters). Generate with: openssl rand -hex 32
SESSION_SECRET=
FORM_SECRET=
CRON_SECRET=

# Emails that may sign in to Studio, comma separated
ADMIN_EMAILS=

# Image storage: "local" (files under STORAGE_DIR) or "s3" (S3 behind CloudFront)
# Development: ./storage   Production on Lightsail: /srv/shilpee-media (Nginx serves public/img from there)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Where browsers load images from. Local disk: /media. S3 + CloudFront: https://img.your-domain.com
NEXT_PUBLIC_MEDIA_BASE_URL=/media
S3_REGION=ap-south-1
# Only with STORAGE_DRIVER=s3: the public bucket behind CloudFront (img/...)
S3_PUBLIC_BUCKET=
# Private bucket: nightly database backups and a copy of the image folder (and originals with s3)
S3_PRIVATE_BUCKET=
# Keys for an IAM user that may write to the private bucket and send email (Lightsail has no IAM roles)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Email: "console" (writes to STORAGE_DIR/outbox) or "ses"
MAIL_DRIVER=console
MAIL_FROM="Shilpee Maitra <studio@shilpeemaitra.com>"
SES_REGION=ap-south-1

# Optional: Umami Cloud website id (cookie-free analytics)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
